{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EmailMessage",
  "type": "object",
  "required": ["tenantId", "network", "payload"],
  "properties": {
    "tenantId": { "type": "string" },
    "network": { "type": "string", "enum": ["email"] },
    "payload": {
      "type": "object",
      "required": ["from", "to", "subject", "body", "sentAt"],
      "properties": {
        "from": { "type": "string", "format": "email" },
        "to": {
          "type": "array",
          "items": { "type": "string", "format": "email" }
        },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "sentAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
